+QStringList DolphinMainWindow::openLocations() const
+{
+    QStringList locations;
+    for (int i = 0; i < m_tabWidget->count(); ++i) {
+        const auto *tab = m_tabWidget->tabPageAt(i);
+        if (!tab) {
+            continue;
+        }
+        locations.append(tab->primaryViewContainer()->url().toString(QUrl::FullyEncoded | QUrl::RemovePassword));
+        if (tab->splitViewEnabled() && tab->secondaryViewContainer()) {
+            locations.append(tab->secondaryViewContainer()->url().toString(QUrl::FullyEncoded | QUrl::RemovePassword));
+        }
+    }
+    locations.removeDuplicates();
+    return locations;
+}
