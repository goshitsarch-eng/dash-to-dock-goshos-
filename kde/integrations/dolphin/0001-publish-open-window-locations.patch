+DolphinWindowLocations DBusInterface::openWindowsWithLocations() const
+{
+    DolphinWindowLocations windows;
+    for (auto *widget : QApplication::topLevelWidgets()) {
+        if (auto *window = qobject_cast<DolphinMainWindow *>(widget)) {
+            // Wayland intentionally has no globally meaningful client-side winId().
+            // Dolphin owns one main window per process; clients authenticate this PID
+            // against the unique D-Bus owner and refuse ambiguous task matches.
+            const QString identity = KWindowSystem::isPlatformX11()
+                ? QStringLiteral("x11:%1").arg(window->winId())
+                : QStringLiteral("pid:%1").arg(QCoreApplication::applicationPid());
+            windows.insert(identity, window->openLocations());
+        }
+    }
+    return windows;
+}
+
+void DBusInterface::notifyOpenLocationsChanged()
+{
+    const auto locations = openWindowsWithLocations();
+    if (locations == m_lastLocations) {
+        return;
+    }
+    m_lastLocations = locations;
+    auto message = QDBusMessage::createSignal(QStringLiteral("/org/freedesktop/FileManager1"),
+                                            QStringLiteral("org.freedesktop.DBus.Properties"),
+                                            QStringLiteral("PropertiesChanged"));
+    message.setArguments({QStringLiteral("org.freedesktop.FileManager1"),
+                          QVariantMap{{QStringLiteral("OpenWindowsWithLocations"), QVariant::fromValue(locations)}},
+                          QStringList{}});
+    QDBusConnection::sessionBus().send(message);
+}
